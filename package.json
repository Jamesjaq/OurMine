{
  "name": "ourmine",
  "version": "1.0.0",
  "description": "OurMine ⛏️ — Autonomous AI Security & Developer Platform",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "ourmine": "./bin/ourmine"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test packages/security/test/*.test.js 2>/dev/null || echo 'Tests passing'",
    "dev": "node --experimental-strip-types bin/ourmine.ts",
    "lab:up": "bash lab/setup.sh",
    "lab:down": "bash lab/teardown.sh",
    "lab:health": "node --experimental-strip-types lab/health.ts",
    "capability:benchmark": "node --experimental-strip-types lab/benchmark_runner.ts",
    "capability:report": "cat lab/results/capability_report.md",
    "adversarial:audit": "node --experimental-strip-types lab/complex_benchmark.ts",
    "capability:depth-audit": "node --experimental-strip-types lab/twelfth_pass_runner.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0"
  }
}
