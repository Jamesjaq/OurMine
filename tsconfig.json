{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ourmine/core": ["./packages/core/src/index.ts"],
      "@opencode-ai/core": ["./packages/core/src/index.ts"],
      "@ourmine/security": ["./packages/security/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "packages/ui", "packages/tui", "packages/opencode"]
}
