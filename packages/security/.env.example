# ARES battle-ready configuration
# Copy to .env.local and fill in secrets — NEVER commit .env.local
#
# OURMINE_BATTLE_READY=1 enables start-and-go defaults on any host.
# On Kali Linux, battle-ready is automatic unless OURMINE_ALLOW_DRY_RUN=1.

OURMINE_BATTLE_READY=1
OURMINE_LIVE=1
# Auto-attest RoE for authorized lab engagements only
OURMINE_ROE_SIGNED=1
OURMINE_PASSIVE_INTEL=1
OURMINE_MCP_EFFICIENT=1
OURMINE_INTEL_REFRESH=1

# Passive recon API keys (optional — Shodan alone enables passive intel)
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
